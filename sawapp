function AshokaChakra({ size = 40, color = ASHOKA_BLUE }) {
  const cx = size / 2, cy = size / 2, r = size / 2 - 2;
  const spokes = Array.from({ length: 24 }, (_, i) => {
    const angle = (i * 360) / 24;
    const rad = (angle * Math.PI) / 180;
    const x2 = cx + r * 0.85 * Math.cos(rad);
    const y2 = cy + r * 0.85 * Math.sin(rad);
    return { x1: cx, y1: cy, x2, y2 };
  });
  return (
    <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>
      <circle cx={cx} cy={cy} r={r} fill="none" stroke={color} strokeWidth="1.5" />
      <circle cx={cx} cy={cy} r={3} fill={color} />
      {spokes.map((s, i) => (
        <line key={i} x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke={color} strokeWidth="0.8" />
      ))}
    </svg>
  );
}

